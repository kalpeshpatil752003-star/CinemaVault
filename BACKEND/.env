# ═══════════════════════════════════════════════════════════════
# CINEMAVAULT BACKEND - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# DATABASE - PostgreSQL
# ═══════════════════════════════════════════════════════════════

# Local Development
DATABASE_URL=postgresql://postgres:admin@localhost:5432/cinemavault

# Or use Railway/Render connection string:
# DATABASE_URL="postgresql://user:password@host:port/database"

# ═══════════════════════════════════════════════════════════════
# JWT Authentication
# ═══════════════════════════════════════════════════════════════

# Generate a strong secret key (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cbc8ac931ff0e95c9b82417e6385e66c3aa704da3c598c771974254a07143d1c
JWT_EXPIRE=7d

# ═══════════════════════════════════════════════════════════════
# TMDB API (for frontend integration)
# ═══════════════════════════════════════════════════════════════

TMDB_API_KEY=f7919dfdb6ddf2bf5528aec022db0db9

# ═══════════════════════════════════════════════════════════════
# Optional: Email Service (for future password reset)
# ═══════════════════════════════════════════════════════════════

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
