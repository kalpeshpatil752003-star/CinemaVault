// ═══════════════════════════════════════════════════════════════
// PRISMA SCHEMA - CinemaVault Database (Corrected & Production-Ready)
// Compatible with Prisma v7+
// ═══════════════════════════════════════════════════════════════

// Prisma Client Generator

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

// Datasource (URL configured in prisma.config.ts)

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// USER MODEL
// ═══════════════════════════════════════════════════════════════

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String // bcrypt hashed password

  // Relations
  watchlist    WatchlistItem[]
  watchHistory WatchHistory[]
  reviews      Review[]
  preferences  UserPreferences?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// USER PREFERENCES (One-to-One with User)
// ═══════════════════════════════════════════════════════════════

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UI Preferences
  theme         String @default("default") // default | neon | classic
  watchlistSort String @default("newest") // newest | oldest

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_preferences")
}

// ═══════════════════════════════════════════════════════════════
// WATCHLIST
// Each user can add the same movie independently
// Composite unique constraint prevents duplicates per user
// ═══════════════════════════════════════════════════════════════

model WatchlistItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Movie data
  tmdbMovieId Int
  title       String
  posterPath  String?
  releaseDate String?
  voteAverage Float?
  overview    String?

  // Metadata
  addedAt DateTime @default(now())

  // Prevent duplicate movies per user
  @@unique([userId, tmdbMovieId])
  // Performance indexes
  @@index([userId])
  @@index([tmdbMovieId])
  @@map("watchlist_items")
}

// ═══════════════════════════════════════════════════════════════
// WATCH HISTORY
// Tracks viewing behavior and repeat watches
// ═══════════════════════════════════════════════════════════════

model WatchHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Movie data
  tmdbMovieId Int
  title       String
  posterPath  String?
  releaseDate String?
  mediaType   String  @default("Movie") // Movie | Show

  // Tracking
  lastWatched DateTime @default(now())
  watchCount  Int      @default(1)

  // Prevent duplicate history rows per user/movie
  @@unique([userId, tmdbMovieId])
  // Performance indexes
  @@index([userId])
  @@index([tmdbMovieId])
  @@map("watch_history")
}

// ═══════════════════════════════════════════════════════════════
// REVIEWS
// Users can review movies
// ═══════════════════════════════════════════════════════════════

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Movie info
  tmdbMovieId Int
  movieTitle  String

  // Review content
  author  String
  content String
  rating  Int?   @default(5) // 1–5 stars

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance indexes
  @@index([userId])
  @@index([tmdbMovieId])
  @@map("reviews")
}
