/* CinemaVault Styles - Pure CSS */

/* Import Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&family=Bebas+Neue&family=Crimson+Text:ital@0;1&display=swap');

/* CSS Variables - Color Scheme */
:root {
  --color-bg-primary: #1a1a1a;
  --color-bg-secondary: #2d2d2d;
  --color-accent: #00d4ff;
  --color-text-primary: #ffffff;
  --color-text-secondary: #b0b0b0;
  --color-border: #3a3a3a;
  --header-height: 58px;
  
  --radius-card: 12px;
  --radius-button: 8px;
  
  --shadow-card: 0 4px 6px rgba(0, 0, 0, 0.3);
  --shadow-card-hover: 0 8px 20px rgba(0, 212, 255, 0.15);
  
  --transition-speed: 0.3s;

  /* Experience feature theme variables */
  --xp-bg: #1a1a1a;
  --xp-fg: #ffffff;
  --xp-accent: #00d4ff;
  --xp-font-display: 'Inter', sans-serif;
  --xp-font-body: 'Inter', sans-serif;
  --xp-filter: none;
}

/* Reset and Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  line-height: 1.6;
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  outline: none;
}

/* Header Styles */
.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: rgba(26, 26, 26, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-border);
}

.header-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: transform var(--transition-speed) ease;
}

.logo:hover {
  transform: translateY(-2px);
}

.logo-icon {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, var(--color-accent), #0099cc);
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
}

.logo-text h1 {
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--color-accent), #0099cc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-text p {
  font-size: 0.75rem;
  color: var(--color-text-secondary);
}

.nav {
  display: flex;
  gap: 2rem;
  align-items: center;
}

.nav a {
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: color var(--transition-speed) ease;
}

.nav a:hover,
.nav a.active {
  color: var(--color-accent);
}

.mobile-menu-btn {
  display: none;
  background: transparent;
  color: var(--color-text-primary);
  font-size: 1.5rem;
  padding: 0.5rem;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all var(--transition-speed) ease;
}

.mobile-menu-btn:hover {
  color: var(--color-accent);
  border-color: var(--color-accent);
  border-radius: var(--radius-button);
}

.mobile-nav {
  display: none;
  flex-direction: column;
  background-color: var(--color-bg-secondary);
  border-bottom: 1px solid var(--color-border);
  padding: 1rem 2rem;
  gap: 1rem;
}

.mobile-nav a {
  color: var(--color-text-primary);
  font-weight: 500;
  transition: color var(--transition-speed) ease;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--color-border);
}

.mobile-nav a:last-child {
  border-bottom: none;
}

.mobile-nav a:hover {
  color: var(--color-accent);
}

/* Hero Section */
.hero {
  padding: 5rem 2rem;
  text-align: center;
  border-bottom: 1px solid var(--color-border);
  background: linear-gradient(180deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%);
}

.hero-content {
  max-width: 800px;
  margin: 0 auto;
}

.hero h2 {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 1rem;
  line-height: 1.2;
}

.hero .accent-text {
  color: var(--color-accent);
  display: block;
  margin-top: 0.5rem;
}

.hero p {
  font-size: 1.125rem;
  color: var(--color-text-secondary);
  margin-top: 1rem;
}

/* Filters Section */
.filters {
  padding: 2rem;
  background-color: rgba(45, 45, 45, 0.5);
  border-bottom: 1px solid var(--color-border);
}

.filters-container {
  max-width: 1400px;
  margin: 0 auto;
}

.search-sort {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.search-box {
  flex: 1;
  position: relative;
}

.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-text-secondary);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 0.875rem 1rem 0.875rem 3rem;
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-button);
  color: var(--color-text-primary);
  font-size: 1rem;
  transition: all var(--transition-speed) ease;
}

.search-input:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
}

.sort-box {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.sort-icon {
  color: var(--color-text-secondary);
}

.sort-select {
  padding: 0.875rem 1rem;
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-button);
  color: var(--color-text-primary);
  font-size: 1rem;
  min-width: 200px;
  cursor: pointer;
  transition: all var(--transition-speed) ease;
}

.sort-select:focus {
  outline: none;
  border-color: var(--color-accent);
}

.clear-btn {
  padding: 0.875rem 1.25rem;
  background-color: transparent;
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-button);
  color: var(--color-accent);
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-speed) ease;
}

.clear-btn:hover {
  background-color: rgba(0, 212, 255, 0.1);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
}

.genre-filters h3 {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  margin-bottom: 0.75rem;
  font-weight: 500;
}

.type-filter-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.type-reset-btn {
  padding: 0.6rem 1rem;
  background-color: transparent;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-speed) ease;
}

.type-reset-btn:hover {
  border-color: var(--color-accent);
  color: var(--color-text-primary);
}

.type-reset-btn.active {
  background-color: rgba(0, 212, 255, 0.14);
  border-color: rgba(0, 212, 255, 0.45);
  color: var(--color-text-primary);
}

.type-switch {
  position: relative;
  display: inline-grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr));
  align-items: center;
  padding: 0.2rem;
  border: 1px solid rgba(0, 212, 255, 0.22);
  border-radius: 999px;
  background: linear-gradient(180deg, #242c36, #181d24);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 10px 24px rgba(0, 0, 0, 0.22);
  overflow: hidden;
}

.type-switch::before {
  content: "";
  position: absolute;
  top: 0.2rem;
  bottom: 0.2rem;
  left: 0.2rem;
  width: calc(50% - 0.2rem);
  border-radius: 999px;
  background: linear-gradient(135deg, #00d4ff, #6be6ff);
  box-shadow:
    0 10px 24px rgba(0, 212, 255, 0.28),
    inset 0 -2px 6px rgba(0, 0, 0, 0.16);
  transition: transform var(--transition-speed) ease;
}

.type-switch.show-active::before {
  transform: translateX(100%);
}

.type-switch-btn {
  position: relative;
  z-index: 1;
  padding: 0.8rem 1.25rem;
  background-color: transparent;
  border: none;
  border-radius: 999px;
  color: #d8e2ee;
  font-size: 0.875rem;
  font-weight: 700;
  cursor: pointer;
  transition: color var(--transition-speed) ease;
}

.type-switch-btn.active {
  color: #08131a;
}

.genre-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.genre-btn {
  padding: 0.5rem 1rem;
  background-color: transparent;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-button);
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  font-weight: 500;
  transition: all var(--transition-speed) ease;
}

.genre-btn:hover {
  background-color: var(--color-bg-secondary);
  border-color: var(--color-accent);
}

.genre-btn.active {
  background-color: var(--color-accent);
  color: var(--color-bg-primary);
  border-color: var(--color-accent);
}

/* Movies Section */
.movies-section {
  padding: 3rem 2rem;
}

.movies-container {
  max-width: 1400px;
  margin: 0 auto;
}

.movies-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.watchlist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  gap: 1rem;
}

.movies-count {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}

.movies-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 2rem;
}

/* Movie Card */
.movie-card {
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: all var(--transition-speed) ease;
  cursor: pointer;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.movie-card:hover {
  transform: scale(1.05);
  box-shadow: var(--shadow-card-hover);
}

.movie-poster {
  position: relative;
  aspect-ratio: 2/3;
  overflow: hidden;
}

.movie-poster img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-speed) ease;
}

.movie-card:hover .movie-poster img {
  transform: scale(1.1);
}

.movie-info {
  padding: 1.25rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.movie-title-row {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 0.5rem;
}

.movie-title {
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.3;
  flex: 1;
  transition: color var(--transition-speed) ease;
}

.movie-card:hover .movie-title {
  color: var(--color-accent);
}

.movie-year {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.movie-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.stars {
  display: flex;
  gap: 0.125rem;
}

.star {
  color: var(--color-text-secondary);
  font-size: 1rem;
}

.star.filled {
  color: var(--color-accent);
}

.rating-value {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-accent);
}

.review-count {
  font-size: 0.75rem;
  color: var(--color-text-secondary);
}

.movie-genres {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}

.genre-badge {
  padding: 0.25rem 0.625rem;
  background-color: rgba(0, 212, 255, 0.1);
  border: 1px solid rgba(0, 212, 255, 0.3);
  border-radius: var(--radius-button);
  font-size: 0.75rem;
  color: var(--color-accent);
}

/* No Results */
.no-results {
  text-align: center;
  padding: 4rem 2rem;
}

.no-results p {
  font-size: 1.125rem;
  color: var(--color-text-secondary);
  margin-bottom: 1.5rem;
}

.btn {
  padding: 0.75rem 1.5rem;
  background-color: transparent;
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-button);
  color: var(--color-accent);
  font-size: 1rem;
  font-weight: 500;
  transition: all var(--transition-speed) ease;
}

.btn:hover {
  background-color: var(--color-accent);
  color: var(--color-bg-primary);
}

/* Footer */
.footer {
  border-top: 1px solid var(--color-border);
  padding: 2rem;
  background-color: rgba(45, 45, 45, 0.5);
  text-align: center;
}

.footer p {
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  margin-bottom: 0.5rem;
}

.footer p:last-child {
  font-size: 0.75rem;
}

/* Movie Detail Page Styles */
.back-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background-color: transparent;
  color: var(--color-text-secondary);
  border-radius: var(--radius-button);
  transition: all var(--transition-speed) ease;
  margin: 1rem 2rem;
}

.back-button:hover {
  background-color: var(--color-bg-secondary);
  color: var(--color-accent);
}

.detail-hero {
  padding: 2rem;
}

.detail-container {
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
}

.detail-poster {
  position: sticky;
  top: 6rem;
  align-self: start;
}

.detail-poster img {
  width: 100%;
  border-radius: var(--radius-card);
  box-shadow: 0 20px 40px rgba(0, 212, 255, 0.2);
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.detail-header h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  margin-bottom: 1rem;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.detail-genres {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.rating-box {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1.5rem;
  background-color: rgba(45, 45, 45, 0.5);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
}

.rating-stars {
  display: flex;
  gap: 0.25rem;
}

.rating-stars .star {
  font-size: 1.25rem;
}

.rating-details .rating-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-accent);
}

.rating-details .review-count {
  font-size: 0.75rem;
}

.section-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.synopsis {
  color: var(--color-text-secondary);
  line-height: 1.8;
  font-size: 1rem;
}

.cast-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.cast-badge {
  padding: 0.5rem 1rem;
  background-color: transparent;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-button);
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}

.trailer-container {
  aspect-ratio: 16/9;
  border-radius: var(--radius-card);
  overflow: hidden;
  background-color: var(--color-bg-secondary);
}

.trailer-container iframe {
  width: 100%;
  height: 100%;
  border: none;
}

.separator {
  height: 1px;
  background-color: var(--color-border);
  margin: 3rem 0;
}

.reviews-section {
  padding: 2rem;
}

.reviews-container {
  max-width: 1400px;
  margin: 0 auto;
}

.reviews-grid {
  display: grid;
  gap: 1.5rem;
}

.review-card {
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 1.5rem;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 1rem;
}

.review-author {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.review-date {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
}

.review-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.review-comment {
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .detail-container {
    grid-template-columns: 1fr;
  }
  
  .detail-poster {
    position: relative;
    top: 0;
    max-width: 400px;
    margin: 0 auto;
  }
}

@media (max-width: 768px) {
  .nav {
    display: none;
  }
  
  .mobile-menu-btn {
    display: block;
  }
  
  .mobile-nav {
    display: flex;
  }
  
  .hero h2 {
    font-size: 2rem;
  }
  
  .hero p {
    font-size: 1rem;
  }
  
  .search-sort {
    flex-direction: column;
  }
  
  .sort-select {
    width: 100%;
  }
  
  .movies-grid {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  
  .detail-header h1 {
    font-size: 1.75rem;
  }
}

@media (max-width: 480px) {
  .header-container {
    padding: 1rem;
  }
  
  .hero {
    padding: 3rem 1rem;
  }
  
  .filters {
    padding: 1.5rem 1rem;
  }
  
  .movies-section {
    padding: 2rem 1rem;
  }
  
  .movies-grid {
    grid-template-columns: 1fr;
  }
}

/* Directors Page Styles */
.directors-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.director-card {
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 2rem;
  transition: all var(--transition-speed) ease;
}

.director-card:hover {
  border-color: var(--color-accent);
  box-shadow: 0 4px 20px rgba(0, 212, 255, 0.1);
}

.director-header {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
}

.director-icon {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, var(--color-accent), #0099cc);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  flex-shrink: 0;
}

.director-info h2 {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--color-text-primary);
}

.director-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.stat-value {
  color: var(--color-accent);
  font-weight: 600;
}

.director-movies {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.5rem;
}

.director-movie-card {
  background-color: rgba(26, 26, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-button);
  overflow: hidden;
  transition: all var(--transition-speed) ease;
  cursor: pointer;
}

.director-movie-card:hover {
  transform: translateY(-4px);
  border-color: var(--color-accent);
  box-shadow: 0 4px 12px rgba(0, 212, 255, 0.2);
}

.director-movie-poster {
  position: relative;
  aspect-ratio: 2/3;
  overflow: hidden;
}

.director-movie-poster img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-speed) ease;
}

.director-movie-card:hover .director-movie-poster img {
  transform: scale(1.05);
}

.director-movie-info {
  padding: 1rem;
}

.director-movie-title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}

.director-movie-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.875rem;
}

.director-movie-year {
  color: var(--color-text-secondary);
}

.director-movie-rating {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  color: var(--color-accent);
  font-weight: 600;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.movie-card {
  animation: fadeIn 0.5s ease forwards;
}

.movie-card:nth-child(1) { animation-delay: 0.05s; }
.movie-card:nth-child(2) { animation-delay: 0.1s; }
.movie-card:nth-child(3) { animation-delay: 0.15s; }
.movie-card:nth-child(4) { animation-delay: 0.2s; }

.director-card {
  animation: fadeIn 0.5s ease forwards;
}

.director-card:nth-child(1) { animation-delay: 0.05s; }
.director-card:nth-child(2) { animation-delay: 0.1s; }
.director-card:nth-child(3) { animation-delay: 0.15s; }

/* Responsive for Directors Page */
@media (max-width: 768px) {
  .director-header {
    flex-direction: column;
    text-align: center;
  }
  
  .director-icon {
    width: 60px;
    height: 60px;
    font-size: 2rem;
  }
  
  .director-info h2 {
    font-size: 1.5rem;
  }
  
  .director-stats {
    justify-content: center;
  }
  
  .director-movies {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }
}

/* Account Menu Styles */
.account-menu {
  position: relative;
}

.account-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: transparent;
  color: var(--color-text-primary);
  border-radius: var(--radius-button);
  transition: background-color var(--transition-speed) ease;
  font-size: 0.9rem;
}

.account-btn:hover {
  background-color: var(--color-bg-secondary);
}

.account-name {
  max-width: 120px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-icon {
  font-size: 0.8rem;
  transition: transform var(--transition-speed) ease;
}

.account-menu:hover .account-icon {
  transform: rotate(180deg);
}

.account-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: 0.5rem;
  background-color: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  min-width: 200px;
  z-index: 1000;
}

.account-info {
  padding: 1rem;
  border-bottom: 1px solid var(--color-border);
}

.account-email {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  margin-bottom: 0.25rem;
}

.account-member {
  font-size: 0.8rem;
  color: var(--color-text-secondary);
}

.account-actions {
  padding: 0.5rem 0;
}

.account-action {
  display: block;
  width: 100%;
  padding: 0.75rem 1rem;
  background: transparent;
  color: var(--color-text-primary);
  text-align: left;
  border: none;
  cursor: pointer;
  transition: background-color var(--transition-speed) ease;
  font-size: 0.9rem;
}

.account-action:hover {
  background-color: rgba(0, 212, 255, 0.1);
}

.account-action.logout {
  color: #ff6b6b;
}

.account-action.logout:hover {
  background-color: rgba(255, 107, 107, 0.1);
}

.account-action + .account-action {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
   ========================= */

.review-form {
  background: linear-gradient(145deg, #1c1c1c, #141414);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 1.5rem;
  margin: 2rem 0;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.review-form h3 {
  margin-bottom: 1rem;
  font-size: 1.3rem;
  color: var(--color-text-primary);
}

.review-form input,
.review-form textarea {
  width: 100%;
  background: #0f0f0f;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 0.8rem 1rem;
  margin-bottom: 1rem;
  color: var(--color-text-primary);
  font-size: 0.95rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.review-form input::placeholder,
.review-form textarea::placeholder {
  color: rgba(255, 255, 255, 0.45);
}

.review-form input:focus,
.review-form textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px rgba(0, 191, 255, 0.25);
}

.review-form textarea {
  min-height: 110px;
  resize: vertical;
}

.review-form .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.6rem 1.4rem;
  font-size: 0.95rem;
  border-radius: 12px;
  background: linear-gradient(135deg, #00bfff, #0077ff);
  color: #fff;
  border: none;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.review-form .btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(0, 191, 255, 0.35);
}

@media (max-width: 600px) {
  .review-form {
    padding: 1.2rem;
  }

  .review-form h3 {
    font-size: 1.15rem;
  }
}

/* Mobile navigation toggle */
.nav.open {
  display: flex;
  flex-direction: column;
  position: absolute;
  top: 100%;
  right: 0;
  background-color: var(--color-bg-primary);
  width: 100%;
  padding: 1rem 0;
  border-top: 1px solid var(--color-border);
}

.director-name {
  cursor: pointer;
}

.director-name:hover {
  color: var(--color-accent);
}


/* =============================================================
   EXPERIENCE PAGE — Global Watch Map · Time Machine · Director's Cut
   ============================================================= */

/* =============================================================
   EXPERIENCE — Landing screen + subnav
   ============================================================= */

/* ── Landing screen ── */
.xp-landing {
  min-height: calc(100vh - var(--header-height));
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: var(--color-bg-primary);
}

/* Radial ambient glow behind the cards */
.xp-landing-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 60% 50% at 20% 60%, rgba(232,201,122,0.07) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 80% 40%, rgba(74,144,217,0.07) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 50% 80%, rgba(255,64,255,0.05) 0%, transparent 70%);
}

.xp-landing-inner {
  text-align: center;
  padding: 4rem 2rem;
  position: relative;
  z-index: 1;
  max-width: 1000px;
  margin: 0 auto;
}

.xp-landing-eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  margin-bottom: 1.25rem;
}

.xp-landing-title {
  font-size: clamp(2.8rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.1;
  color: #fff;
  margin-bottom: 1rem;
}

.xp-landing-accent {
  background: linear-gradient(135deg, #e8c97a, #ff40ff 50%, #4a90d9);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.xp-landing-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.4);
  margin-bottom: 3.5rem;
}

/* ── Landing cards ── */
.xp-landing-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.xp-lcard {
  position: relative;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 2.5rem 2rem;
  cursor: pointer;
  text-align: left;
  color: inherit;
  font-family: inherit;
  overflow: hidden;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  animation: xp-fadein 0.5s ease both;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.xp-lcard:hover {
  transform: translateY(-6px);
  border-color: var(--card-color);
  box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 40px color-mix(in srgb, var(--card-color) 20%, transparent);
}

/* Glow blob inside card */
.xp-lcard-glow {
  position: absolute;
  top: -40px;
  right: -40px;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--card-color) 25%, transparent), transparent 70%);
  pointer-events: none;
  transition: opacity 0.3s;
  opacity: 0.4;
}

.xp-lcard:hover .xp-lcard-glow { opacity: 0.8; }

.xp-lcard-emoji {
  font-size: 2.5rem;
  display: block;
  margin-bottom: 0.5rem;
}

.xp-lcard-label {
  font-size: 1.3rem;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.xp-lcard-sub {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.4);
  line-height: 1.5;
  flex: 1;
}

.xp-lcard-arrow {
  font-size: 1.2rem;
  color: var(--card-color);
  margin-top: 0.75rem;
  display: block;
  transform: translateX(0);
  transition: transform 0.2s;
}

.xp-lcard:hover .xp-lcard-arrow { transform: translateX(6px); }

@media (max-width: 768px) {
  .xp-landing-cards { grid-template-columns: 1fr; gap: 1rem; }
  .xp-lcard { padding: 1.75rem 1.5rem; }
}

/* ── Subnav (shown when a mode is active) ── */
.xp-subnav {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.6rem 2rem;
  margin-top: -1px;
  background: rgba(10,10,10,0.8);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  position: sticky;
  top: var(--header-height);
  z-index: 90;
  backdrop-filter: blur(16px);
}

.xp-subnav-back {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: rgba(255,255,255,0.45);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.45rem 0.9rem;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
  font-family: inherit;
  flex-shrink: 0;
}

.xp-subnav-back:hover { border-color: rgba(255,255,255,0.3); color: #fff; }

.xp-subnav-tabs {
  display: flex;
  gap: 0.25rem;
  flex: 1;
}

.xp-subnav-tab {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 0.9rem;
  background: transparent;
  border: none;
  border-radius: 8px;
  color: rgba(255,255,255,0.35);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
  white-space: nowrap;
}

.xp-subnav-tab:hover { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); }

.xp-subnav-tab--active {
  background: rgba(255,255,255,0.06);
  color: var(--tab-color);
}

.xp-subnav-emoji { font-size: 1rem; }
.xp-subnav-name  { font-size: 0.78rem; }

/* Active pill — right side */
.xp-subnav-active-pill {
  margin-left: auto;
  padding: 0.35rem 0.9rem;
  border: 1px solid;
  border-radius: 100px;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  white-space: nowrap;
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .xp-subnav { flex-wrap: wrap; gap: 0.5rem; padding: 0.6rem 1rem; }
  .xp-subnav-active-pill { display: none; }
  .xp-subnav-name { display: none; }
}

/* Grain animation shared across features */
/* =============================================================
   EXPERIENCE V2 — additions/replacements to styles.css
   Paste this AFTER the existing Experience section in styles.css
   (replace everything from ".map-root" onwards)
   ============================================================= */

/* ── Globe Watch Map ── */
.map-root { display: flex; flex-direction: column; gap: 2rem; }

.map-title {
  font-size: 2.8rem; font-weight: 800; line-height: 1.1;
  color: var(--xp-accent, #00d4ff); margin-bottom: 0.3rem;
}
.map-subtitle {
  font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: rgba(255,255,255,0.3);
}

.map-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 1.5rem;
  align-items: start;
}

.globe-wrap {
  position: relative;
  background: #070b12;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
  aspect-ratio: 4/3;
}

.globe-mount { width: 100%; height: 100%; cursor: grab; }
.globe-mount:active { cursor: grabbing; }

.globe-tooltip {
  position: absolute;
  bottom: 1rem; left: 50%; transform: translateX(-50%);
  background: rgba(0,0,0,0.75);
  color: #fff;
  padding: 0.4rem 1rem;
  border-radius: 100px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  pointer-events: none;
  border: 1px solid rgba(255,255,255,0.1);
  backdrop-filter: blur(8px);
  animation: xp-fadein 0.15s ease;
}

.map-sidebar {
  display: flex; flex-direction: column; gap: 0.5rem;
  max-height: 70vh; overflow-y: auto;
}
.map-sidebar::-webkit-scrollbar { width: 4px; }
.map-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

.sidebar-label {
  font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: rgba(255,255,255,0.3); margin-bottom: 0.25rem; flex-shrink: 0;
}

.country-list { display: flex; flex-direction: column; gap: 0.4rem; }

.country-card {
  display: flex; align-items: center; gap: 0.7rem;
  padding: 0.65rem 0.9rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 9px;
  cursor: pointer; transition: all 0.18s;
  text-align: left; color: inherit; font-family: inherit; width: 100%;
}
.country-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15); }
.country-card--active { background: rgba(255,255,255,0.05); }

.country-flag  { font-size: 1.2rem; flex-shrink: 0; }
.country-name  { font-size: 0.78rem; font-weight: 600; flex: 1; }
.country-dot-color { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

.selected-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; padding: 1.1rem;
  margin-top: 0.5rem; flex-shrink: 0;
  animation: xp-fadein 0.35s ease;
}
.selected-label { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.75rem; font-weight: 700; }
.selected-loading {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.35);
}

.selected-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,0.1);
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
.selected-movie-row { display: flex; gap: 0.75rem; margin-bottom: 0.85rem; }
.selected-poster { width: 48px; height: 72px; object-fit: cover; border-radius: 5px; flex-shrink: 0; }
.selected-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.25rem; line-height: 1.3; }
.selected-meta  { font-size: 0.67rem; color: rgba(255,255,255,0.4); margin-bottom: 0.35rem; }
.selected-overview { font-size: 0.7rem; color: rgba(255,255,255,0.5); line-height: 1.6; }
.selected-btn {
  display: inline-block; padding: 0.45rem 1.1rem;
  border: 1px solid; border-radius: 6px; background: transparent;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.selected-btn:hover { opacity: 0.7; transform: translateY(-1px); }

@media (max-width: 768px) {
  .map-layout { grid-template-columns: 1fr; }
  .globe-wrap { aspect-ratio: 1/1; }
  .map-sidebar { max-height: none; }
}


/* ── Time Machine V2 ── */
.tm-root { display: flex; flex-direction: column; gap: 2.5rem; max-width: 900px; margin: 0 auto; }

.tm-header { display: flex; flex-direction: column; gap: 0.35rem; }
.tm-title  { font-size: 2.6rem; font-weight: 700; color: var(--xp-accent,#00d4ff); line-height: 1.1; transition: font-family 0.4s; }
.tm-subtitle { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.3); }
.tm-reset-btn {
  align-self: flex-start; margin-top: 0.4rem;
  padding: 0.38rem 1rem; background: transparent;
  border: 1px solid rgba(255,255,255,0.15); border-radius: 100px;
  color: rgba(255,255,255,0.4); font-size: 0.72rem; letter-spacing: 0.1em;
  cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.tm-reset-btn:hover { border-color: rgba(255,255,255,0.4); color: rgba(255,255,255,0.8); }

.tm-track {
  position: relative; display: flex;
  justify-content: space-between; align-items: flex-start; padding: 0 0.5rem;
}
.tm-track-line {
  position: absolute; top: 10px; left: 0.5rem; right: 0.5rem;
  height: 1px; background: rgba(255,255,255,0.1);
}
.tm-stop {
  position: relative; display: flex; flex-direction: column;
  align-items: center; gap: 0.5rem; background: transparent;
  border: none; cursor: pointer; z-index: 1; font-family: inherit;
}
.tm-dot {
  width: 14px; height: 14px; border-radius: 50%;
  background: rgba(255,255,255,0.15); border: 2px solid rgba(255,255,255,0.2);
  transition: all 0.35s;
}
.tm-stop--active .tm-dot { transform: scale(1.4); }
.tm-year { font-size: 0.63rem; color: rgba(255,255,255,0.35); transition: color 0.35s; white-space: nowrap; }

/* Card transitions */
.tm-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 16px; padding: 2.5rem;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; gap: 2rem;
  transition: border-color 0.5s, opacity 0.3s, transform 0.3s;
}
.tm-card--out { opacity: 0; transform: translateY(8px); }
.tm-card--in  { opacity: 1; transform: translateY(0); animation: xp-fadein 0.35s ease; }

.tm-ghost-year {
  position: absolute; font-family: 'Bebas Neue', sans-serif;
  font-size: 9rem; color: rgba(255,255,255,0.03);
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  pointer-events: none; letter-spacing: 0.08em; white-space: nowrap;
}

.tm-card-top { display: flex; flex-direction: column; gap: 0.85rem; position: relative; z-index: 1; }

.tm-badge {
  display: inline-block; padding: 0.28rem 1rem;
  border: 1px solid; border-radius: 100px;
  font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
  transition: all 0.4s; align-self: flex-start;
}
.tm-era-name { font-size: 2rem; font-weight: 700; color: var(--xp-fg,#fff); line-height: 1.2; transition: font-family 0.4s; }
.tm-era-desc { font-size: 0.88rem; color: rgba(255,255,255,0.45); max-width: 600px; line-height: 1.75; }

/* Real posters row */
.tm-posters-row {
  display: flex; gap: 0.85rem; overflow-x: auto; padding-bottom: 0.5rem;
  position: relative; z-index: 1;
}
.tm-posters-row::-webkit-scrollbar { height: 3px; }
.tm-posters-row::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 2px; }

.tm-poster-btn {
  flex-shrink: 0; background: transparent; border: none;
  cursor: pointer; display: flex; flex-direction: column;
  align-items: center; gap: 0.5rem; transition: transform 0.2s;
}
.tm-poster-btn:hover { transform: translateY(-4px) scale(1.03); }

.tm-poster-img {
  width: 110px; height: 165px; object-fit: cover;
  border-radius: 8px; display: block;
  box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
.tm-poster-placeholder {
  width: 110px; height: 165px; border-radius: 8px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.7rem; color: rgba(255,255,255,0.3);
  padding: 0.75rem; text-align: center; line-height: 1.4;
}
.tm-poster-title {
  font-size: 0.65rem; color: rgba(255,255,255,0.4);
  max-width: 110px; text-align: center; line-height: 1.3;
}


/* ── Director's Cut V2 ── */
.dc-root { display: flex; flex-direction: column; gap: 2rem; }

.dc-header { display: flex; flex-direction: column; gap: 0.35rem; }
.dc-title   { font-size: 2.6rem; font-weight: 800; line-height: 1.1; }
.dc-subtitle { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.3); }

.dc-controls { display: flex; gap: 0.75rem; margin-top: 0.75rem; align-items: center; }
.dc-search {
  flex: 1; max-width: 300px; padding: 0.55rem 1rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px; color: #fff; font-size: 0.82rem;
  font-family: inherit; outline: none; transition: border-color 0.2s;
}
.dc-search::placeholder { color: rgba(255,255,255,0.3); }
.dc-search:focus { border-color: var(--xp-accent,#00d4ff); }

.dc-reset-btn {
  padding: 0.5rem 1.1rem; background: transparent;
  border: 1px solid rgba(255,255,255,0.15); border-radius: 100px;
  color: rgba(255,255,255,0.4); font-size: 0.72rem; letter-spacing: 0.1em;
  cursor: pointer; transition: all 0.2s; font-family: inherit;
}
.dc-reset-btn:hover { border-color: rgba(255,255,255,0.4); color: rgba(255,255,255,0.8); }

.dc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 0.6rem;
}
.dc-btn {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px; padding: 1rem 0.75rem;
  cursor: pointer; transition: all 0.22s;
  text-align: center; color: inherit; font-family: inherit;
  display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
}
.dc-btn:hover { border-color: rgba(255,255,255,0.18); transform: translateY(-2px); }
.dc-btn--active { }

.dc-emoji    { font-size: 1.6rem; }
.dc-btn-name { font-size: 0.72rem; font-weight: 700; color: var(--xp-fg,#fff); line-height: 1.3; }
.dc-btn-style { font-size: 0.6rem; color: rgba(255,255,255,0.3); line-height: 1.3; }

/* Preview card — transforms to match director */
.dc-preview {
  border-radius: 16px; border: 1px solid;
  padding: 2rem; position: relative; overflow: hidden;
  display: grid; grid-template-columns: 1fr auto;
  gap: 2rem; align-items: center;
  min-height: 240px;
  animation: xp-fadein 0.4s ease;
  transition: background 0.5s, color 0.5s, border-color 0.5s;
}

.dc-preview-decoration {
  position: absolute; right: -1rem; bottom: -1rem;
  font-size: 9rem; opacity: 0.06; pointer-events: none; line-height: 1;
}

.dc-preview-left { display: flex; flex-direction: column; gap: 0.6rem; position: relative; z-index: 1; }
.dc-preview-label { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
.dc-preview-title { font-size: 2rem; font-weight: 700; line-height: 1.2; transition: font-family 0.4s; }
.dc-preview-style { font-size: 0.8rem; }

.dc-traits { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.dc-trait {
  padding: 0.25rem 0.75rem; border: 1px solid;
  border-radius: 100px; font-size: 0.68rem; opacity: 0.75;
}

/* Posters strip */
.dc-preview-posters {
  display: flex; gap: 0.6rem; flex-shrink: 0;
  position: relative; z-index: 1;
}
.dc-poster-btn {
  background: transparent; border: none;
  cursor: pointer; transition: transform 0.2s; flex-shrink: 0;
}
.dc-poster-btn:hover { transform: translateY(-4px) scale(1.04); }
.dc-poster-img {
  width: 80px; height: 120px; object-fit: cover;
  border-radius: 7px; display: block;
  box-shadow: 0 6px 20px rgba(0,0,0,0.5);
}
.dc-poster-placeholder {
  width: 80px; height: 120px; border-radius: 7px;
  border: 1px solid; display: flex; align-items: center;
  justify-content: center; font-size: 0.62rem;
  padding: 0.5rem; text-align: center; line-height: 1.3;
  opacity: 0.5;
}

@media (max-width: 768px) {
  .dc-preview { grid-template-columns: 1fr; }
  .dc-preview-posters { overflow-x: auto; }
  .dc-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
}

/*/dfddfgsdfgsdfgsdfgd/

/* ═════════════════════════════════════════════════════════════════════════════
   PASTE THIS AT THE END OF YOUR src/styles.css FILE
   GLOBAL WATCH MAP - CINEMATIC & BOLD REDESIGN
   ═════════════════════════════════════════════════════════════════════════════ */

/* Add these CSS variables to your existing :root selector */
/* If you already have :root { ... } then ADD these inside it */
:root {
  /* ... existing variables ... */
  
  /* GlobalWatchMap Variables */
  --gwm-bg: #0a0e14;
  --gwm-surface: #1a2332;
  --gwm-border: rgba(255, 255, 255, 0.08);
  --gwm-text: #ffffff;
  --gwm-text-secondary: rgba(255, 255, 255, 0.6);
  --gwm-text-tertiary: rgba(255, 255, 255, 0.4);
  --gwm-accent: #00d4ff;
  --gwm-spacing: 1.5rem;
}

/* ═════════════════════════════════════════════════════════════════════════════
   GLOBAL WATCH MAP STYLES
   ═════════════════════════════════════════════════════════════════════════════ */

/* Container */
.gwm-root {
  display: flex;
  flex-direction: column;
  gap: var(--gwm-spacing);
  padding: 0;
  background: var(--gwm-bg);
  color: var(--gwm-text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ─────────────────────────────────────────────────────────────────
   HEADER
   ───────────────────────────────────────────────────────────────── */

.gwm-header {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(26, 35, 50, 0.6) 100%);
  border-bottom: 1px solid var(--gwm-border);
  padding: 3rem 2rem;
  position: relative;
  overflow: hidden;
}

.gwm-header::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 400px;
  height: 100%;
  background: radial-gradient(circle at top right, rgba(0, 212, 255, 0.05), transparent);
  pointer-events: none;
}

.gwm-header-content {
  position: relative;
  z-index: 1;
  max-width: 1400px;
  margin: 0 auto;
}

.gwm-title {
  font-size: 3.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0;
  background: linear-gradient(135deg, #ffffff 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gwm-fadeInUp 0.8s ease 0.1s both;
}

.gwm-subtitle {
  font-size: 1rem;
  color: var(--gwm-text-secondary);
  margin: 0.5rem 0 0 0;
  font-weight: 400;
  letter-spacing: 0.01em;
  animation: gwm-fadeInUp 0.8s ease 0.2s both;
}

/* ─────────────────────────────────────────────────────────────────
   FILTER TABS
   ───────────────────────────────────────────────────────────────── */

.gwm-tabs {
  display: flex;
  gap: 1rem;
  padding: 0 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
  animation: gwm-fadeIn 0.8s ease 0.3s both;
}

.gwm-tabs::-webkit-scrollbar {
  display: none;
}

.gwm-tab {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.8rem 1.4rem;
  background: transparent;
  border: 2px solid var(--gwm-border);
  border-radius: 10px;
  color: var(--gwm-text-secondary);
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  white-space: nowrap;
  font-family: inherit;
}

.gwm-tab:hover {
  border-color: var(--gwm-accent);
  color: var(--gwm-accent);
  background: rgba(0, 212, 255, 0.05);
  transform: translateY(-2px);
}

.gwm-tab--active {
  border-color: var(--gwm-accent);
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 212, 255, 0.05) 100%);
  color: var(--gwm-accent);
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
}

.gwm-tab-icon {
  font-size: 1.2rem;
}

.gwm-tab-label {
  letter-spacing: 0.02em;
}

/* ─────────────────────────────────────────────────────────────────
   MAIN LAYOUT
   ───────────────────────────────────────────────────────────────── */

.gwm-layout {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 2rem;
  padding: 0 2rem 2rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

@media (max-width: 1024px) {
  .gwm-layout {
    grid-template-columns: 1fr;
  }
}

/* ─────────────────────────────────────────────────────────────────
   GLOBE CONTAINER
   ───────────────────────────────────────────────────────────────── */

.gwm-globe-wrap {
  position: relative;
  background: #070b12;
  border: 1px solid var(--gwm-border);
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  animation: gwm-fadeIn 0.8s ease 0.4s both;
}

.gwm-globe-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gwm-globe-hint {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(12px);
  padding: 0.6rem 1.4rem;
  border-radius: 100px;
  font-size: 0.9rem;
  color: var(--gwm-text-secondary);
  border: 1px solid var(--gwm-border);
  pointer-events: none;
  animation: gwm-pulse 2s ease-in-out infinite;
}

@keyframes gwm-pulse {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

/* ─────────────────────────────────────────────────────────────────
   SIDEBAR
   ───────────────────────────────────────────────────────────────── */

.gwm-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  animation: gwm-fadeIn 0.8s ease 0.5s both;
}

.gwm-sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.gwm-sidebar-label {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--gwm-text-tertiary);
  margin: 0;
}

.gwm-countries {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  max-height: 320px;
  overflow-y: auto;
  padding-right: 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
}

.gwm-countries::-webkit-scrollbar {
  width: 4px;
}

.gwm-countries::-webkit-scrollbar-track {
  background: transparent;
}

.gwm-countries::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
}

.gwm-countries::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

.gwm-country-btn {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.7rem 0.9rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--gwm-border);
  border-radius: 10px;
  color: var(--gwm-text);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  text-align: left;
  font-family: inherit;
  position: relative;
  overflow: hidden;
}

.gwm-country-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.5s;
}

.gwm-country-btn:hover {
  border-color: rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.06);
  transform: translateX(4px);
}

.gwm-country-btn:hover::before {
  left: 100%;
}

.gwm-country-btn--active {
  border-color: currentColor;
  background: linear-gradient(135deg, var(--gwm-border) 0%, rgba(255, 255, 255, 0.05) 100%);
  box-shadow: inset 0 0 20px rgba(0, 212, 255, 0.08);
  font-weight: 700;
}

.gwm-country-flag {
  font-size: 1.4rem;
  flex-shrink: 0;
}

.gwm-country-name {
  flex: 1;
  font-size: 0.88rem;
}

.gwm-country-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.gwm-country-btn:hover .gwm-country-dot {
  transform: scale(1.3);
}

.gwm-country-btn--active .gwm-country-dot {
  transform: scale(1.4);
  box-shadow: 0 0 12px currentColor;
}

/* ─────────────────────────────────────────────────────────────────
   PREVIEW CARD
   ───────────────────────────────────────────────────────────────── */

.gwm-preview-card {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding: 1.8rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(26, 35, 50, 0.4) 100%);
  border: 1px solid var(--gwm-border);
  border-radius: 16px;
  max-height: 600px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
}

.gwm-preview-card::-webkit-scrollbar {
  width: 4px;
}

.gwm-preview-card::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
}

.gwm-preview-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  animation: gwm-fadeIn 0.5s ease;
}

.gwm-preview-flag {
  font-size: 2rem;
}

.gwm-preview-label {
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
  margin: 0;
  opacity: 0.8;
}

.gwm-preview-region {
  font-size: 1rem;
  font-weight: 700;
  margin: 0.3rem 0 0 0;
}

/* ─────────────────────────────────────────────────────────────────
   MOVIE CAROUSEL NAVIGATION
   ───────────────────────────────────────────────────────────────── */

.gwm-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 0.8rem;
  background: rgba(0, 212, 255, 0.05);
  border-radius: 10px;
  border: 1px solid rgba(0, 212, 255, 0.1);
}

.gwm-carousel-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--gwm-text);
  font-size: 1.2rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
}

.gwm-carousel-btn:hover:not(:disabled) {
  background: rgba(0, 212, 255, 0.2);
  border-color: var(--gwm-accent);
  transform: scale(1.1);
}

.gwm-carousel-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.gwm-carousel-counter {
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  min-width: 60px;
  text-align: center;
}

/* ─────────────────────────────────────────────────────────────────
   MOVIE CONTENT
   ───────────────────────────────────────────────────────────────── */

.gwm-movie-content {
  display: flex;
  flex-direction: column;
  gap: 1.3rem;
}

.gwm-movie-hero {
  display: flex;
  gap: 1rem;
}

.gwm-movie-poster {
  width: 80px;
  height: 120px;
  border-radius: 8px;
  object-fit: cover;
  flex-shrink: 0;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  border: 1px solid var(--gwm-border);
}

.gwm-movie-title-section {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  flex: 1;
  gap: 0.6rem;
}

.gwm-movie-title {
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1.3;
  margin: 0;
  color: var(--gwm-text);
}

.gwm-movie-meta-row {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}

.gwm-meta-item {
  font-size: 0.8rem;
  color: var(--gwm-text-secondary);
  padding: 0.3rem 0.6rem;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 6px;
  white-space: nowrap;
}

/* Details Section */
.gwm-details {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.gwm-detail-row {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.gwm-detail-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--gwm-text-tertiary);
}

.gwm-detail-value {
  font-size: 0.95rem;
  color: var(--gwm-text);
  font-weight: 500;
}

/* Genres */
.gwm-genre-tags {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.gwm-tag {
  padding: 0.35rem 0.75rem;
  border: 1px solid;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  background: transparent;
}

/* Budget Row */
.gwm-budget-row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.gwm-budget-row span {
  font-size: 0.95rem;
  color: var(--gwm-text);
  font-weight: 500;
}

/* Cast */
.gwm-cast {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.gwm-cast-name {
  font-size: 0.9rem;
  color: var(--gwm-text);
  padding: 0.3rem 0.7rem;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.gwm-cast-more {
  font-size: 0.85rem;
  color: var(--gwm-text-secondary);
  padding: 0.3rem 0.7rem;
  font-style: italic;
}

/* Overview */
.gwm-overview {
  padding: 1rem;
  background: rgba(0, 212, 255, 0.04);
  border-left: 3px solid var(--gwm-accent);
  border-radius: 6px;
}

.gwm-overview-text {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--gwm-text-secondary);
}

/* Stats */
.gwm-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
}

.gwm-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
}

.gwm-stat-value {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--gwm-accent);
}

.gwm-stat-label {
  font-size: 0.75rem;
  color: var(--gwm-text-tertiary);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ─────────────────────────────────────────────────────────────────
   CTA BUTTON
   ───────────────────────────────────────────────────────────────── */

.gwm-cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  padding: 1rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 2px solid;
  border-radius: 10px;
  color: inherit;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  font-family: inherit;
  text-transform: uppercase;
  margin-top: 0.5rem;
}

.gwm-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.05) 100%);
}

.gwm-cta-arrow {
  transition: transform 0.3s ease;
}

.gwm-cta-btn:hover .gwm-cta-arrow {
  transform: translateX(4px);
}

/* ─────────────────────────────────────────────────────────────────
   LOADING STATE
   ───────────────────────────────────────────────────────────────── */

.gwm-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 2rem;
  color: var(--gwm-text-secondary);
  font-size: 0.95rem;
}

.gwm-spinner {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-top-color: var(--gwm-accent);
  border-radius: 50%;
  animation: gwm-spin 0.8s linear infinite;
}

@keyframes gwm-spin {
  to { transform: rotate(360deg); }
}

/* ─────────────────────────────────────────────────────────────────
   EMPTY & INTRO STATES
   ───────────────────────────────────────────────────────────────── */

.gwm-empty,
.gwm-intro-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  text-align: center;
  color: var(--gwm-text-secondary);
  font-size: 0.95rem;
}

.gwm-intro-card {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(26, 35, 50, 0.4) 100%);
  border: 1px solid var(--gwm-border);
  border-radius: 16px;
  min-height: 200px;
}

.gwm-intro-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.gwm-intro-text {
  font-size: 1rem;
  margin: 0;
}

/* ─────────────────────────────────────────────────────────────────
   ANIMATIONS
   ───────────────────────────────────────────────────────────────── */

@keyframes gwm-fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes gwm-fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─────────────────────────────────────────────────────────────────
   RESPONSIVE
   ───────────────────────────────────────────────────────────────── */

@media (max-width: 768px) {
  .gwm-root {
    --gwm-spacing: 1rem;
  }

  .gwm-header {
    padding: 2rem 1.5rem;
  }

  .gwm-title {
    font-size: 2.2rem;
  }

  .gwm-tabs {
    padding: 0 1.5rem;
  }

  .gwm-layout {
    padding: 0 1.5rem 1.5rem 1.5rem;
    gap: 1.5rem;
  }

  .gwm-globe-wrap {
    min-height: 300px;
  }

  .gwm-sidebar {
    min-height: 400px;
  }

  .gwm-preview-card {
    max-height: none;
  }

  .gwm-country-name {
    display: none;
  }

  .gwm-countries {
    max-height: 250px;
  }
}

@media (max-width: 480px) {
  .gwm-title {
    font-size: 1.8rem;
  }

  .gwm-subtitle {
    font-size: 0.9rem;
  }

  .gwm-header {
    padding: 1.5rem;
  }

  .gwm-layout {
    padding: 0 1rem 1rem 1rem;
  }

  .gwm-tabs {
    padding: 0 1rem;
    gap: 0.7rem;
  }

  .gwm-tab {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
  }

  .gwm-movie-poster {
    width: 60px;
    height: 90px;
  }

  .gwm-movie-title {
    font-size: 1rem;
  }
}

/* time machine upgrade*/
/* ═════════════════════════════════════════════════════════════════════════════
   TIME MACHINE - FILM EVOLUTION EXPLORER
   Cinematic, Bold Design with Evolution Animations
   ═════════════════════════════════════════════════════════════════════════════ */

.tm-root {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  padding: 0;
  background: linear-gradient(180deg, #0a0e14 0%, #0f1318 100%);
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  min-height: 100vh;
}

/* ─────────────────────────────────────────────────────────────────
   HEADER
   ───────────────────────────────────────────────────────────────── */

.tm-header {
  padding: 3rem 2rem;
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(10, 14, 20, 0.6) 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  animation: tm-fadeInUp 0.8s ease 0.1s both;
}

.tm-title {
  font-size: 3.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0 0 0.5rem 0;
  background: linear-gradient(135deg, #ffffff 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.tm-subtitle {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
  font-weight: 400;
  letter-spacing: 0.01em;
}

/* ─────────────────────────────────────────────────────────────────
   DECADE NAVIGATION
   ───────────────────────────────────────────────────────────────── */

.tm-decade-nav {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 0.8rem;
  padding: 0 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  animation: tm-fadeIn 0.8s ease 0.2s both;
}

.tm-decade-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  font-family: inherit;
  position: relative;
  overflow: hidden;
}

.tm-decade-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.5s;
}

.tm-decade-btn:hover {
  border-color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.06);
  transform: translateY(-2px);
}

.tm-decade-btn:hover::before {
  left: 100%;
}

.tm-decade-btn--active {
  border-color: currentColor;
  color: #000;
  box-shadow: 0 0 30px currentColor;
  transform: scale(1.05);
  font-weight: 700;
}

.tm-decade-label {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.tm-decade-subtext {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.8;
}

/* ─────────────────────────────────────────────────────────────────
   ERA CARD
   ───────────────────────────────────────────────────────────────── */

.tm-era-card {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding: 3rem 2rem;
  margin: 0 auto;
  max-width: 1200px;
  width: 100%;
  border: 1px solid;
  border-radius: 20px;
  position: relative;
  overflow: hidden;
  animation: tm-fadeIn 0.5s ease;
  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.tm-era-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.03), transparent 70%);
  pointer-events: none;
  border-radius: 50%;
}

.tm-era-card--out {
  opacity: 0;
  transform: translateY(20px);
}

.tm-era-card--in {
  opacity: 1;
  transform: translateY(0);
  animation: tm-fadeInUp 0.5s ease;
}

.tm-era-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 2rem;
}

.tm-era-name {
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.2;
  margin: 0 0 0.5rem 0;
  letter-spacing: -0.01em;
}

.tm-era-tagline {
  font-size: 1.2rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  opacity: 0.9;
  line-height: 1.4;
}

.tm-era-desc {
  font-size: 1rem;
  line-height: 1.7;
  opacity: 0.7;
  margin: 0;
  max-width: 700px;
}

/* ─────────────────────────────────────────────────────────────────
   STATS GRID
   ───────────────────────────────────────────────────────────────── */

.tm-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1.5rem;
  position: relative;
  z-index: 1;
  padding: 1.5rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.tm-stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  padding: 1.2rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  text-align: center;
  transition: all 0.3s ease;
}

.tm-stat-box:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-4px);
}

.tm-stat-icon {
  font-size: 1.8rem;
}

.tm-stat-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.7;
}

.tm-stat-value {
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

/* ─────────────────────────────────────────────────────────────────
   KEY EVENTS
   ───────────────────────────────────────────────────────────────── */

.tm-events {
  position: relative;
  z-index: 1;
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.03);
  border-left: 4px solid;
  border-radius: 8px;
}

.tm-events-title {
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0 0 1rem 0;
  opacity: 0.9;
}

.tm-events-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.tm-event-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 0.95rem;
  line-height: 1.5;
  opacity: 0.85;
}

.tm-event-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 10px currentColor;
}

.tm-event-text {
  font-weight: 500;
}

/* ─────────────────────────────────────────────────────────────────
   MOVIES SECTION
   ───────────────────────────────────────────────────────────────── */

.tm-movies-section {
  position: relative;
  z-index: 1;
}

.tm-movies-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin: 0 0 1.5rem 0;
  letter-spacing: 0.01em;
}

.tm-posters-row {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
}

.tm-posters-row::-webkit-scrollbar {
  height: 4px;
}

.tm-posters-row::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
}

.tm-poster-btn {
  flex-shrink: 0;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  transition: all 0.3s ease;
  font-family: inherit;
}

.tm-poster-btn:hover {
  transform: translateY(-6px) scale(1.05);
}

.tm-poster-img {
  width: 120px;
  height: 180px;
  object-fit: cover;
  border-radius: 10px;
  display: block;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: box-shadow 0.3s ease;
}

.tm-poster-btn:hover .tm-poster-img {
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.8);
}

.tm-poster-placeholder {
  width: 120px;
  height: 180px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  color: rgba(255, 255, 255, 0.3);
  padding: 0.75rem;
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
}

.tm-poster-title {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
  max-width: 120px;
  text-align: center;
  line-height: 1.3;
  font-weight: 500;
}

/* ─────────────────────────────────────────────────────────────────
   EVOLUTION ARROW
   ───────────────────────────────────────────────────────────────── */

.tm-evolution-arrow {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  margin-top: 1rem;
  animation: tm-pulse 2s ease-in-out infinite;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
  color: inherit;
  font-size: inherit;
}

.tm-evolution-arrow:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
}

.tm-arrow-text {
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  opacity: 0.8;
}

.tm-arrow-icon {
  font-size: 1.4rem;
  animation: tm-slideRight 1s ease-in-out infinite;
}

@keyframes tm-slideRight {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(8px); }
}

/* ─────────────────────────────────────────────────────────────────
   FOOTER INFO
   ───────────────────────────────────────────────────────────────── */

.tm-info {
  text-align: center;
  padding: 2rem;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.9rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* ─────────────────────────────────────────────────────────────────
   ANIMATIONS
   ───────────────────────────────────────────────────────────────── */

@keyframes tm-fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes tm-fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tm-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* ─────────────────────────────────────────────────────────────────
   RESPONSIVE
   ───────────────────────────────────────────────────────────────── */

@media (max-width: 1024px) {
  .tm-decade-nav {
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
  }

  .tm-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .tm-era-card {
    padding: 2rem 1.5rem;
  }
}

@media (max-width: 768px) {
  .tm-header {
    padding: 2rem 1.5rem;
  }

  .tm-title {
    font-size: 2.2rem;
  }

  .tm-decade-nav {
    padding: 0 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
    gap: 0.6rem;
  }

  .tm-decade-btn {
    padding: 0.8rem 0.5rem;
    font-size: 0.8rem;
  }

  .tm-decade-label {
    font-size: 0.95rem;
  }

  .tm-decade-subtext {
    font-size: 0.6rem;
  }

  .tm-era-card {
    padding: 1.5rem 1.5rem;
    gap: 1.5rem;
  }

  .tm-era-name {
    font-size: 1.8rem;
  }

  .tm-era-tagline {
    font-size: 1rem;
  }

  .tm-era-desc {
    font-size: 0.95rem;
  }

  .tm-stats-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .tm-posters-row {
    gap: 0.8rem;
  }

  .tm-poster-img {
    width: 100px;
    height: 150px;
  }

  .tm-poster-placeholder {
    width: 100px;
    height: 150px;
  }

  .tm-poster-title {
    max-width: 100px;
    font-size: 0.7rem;
  }
}

@media (max-width: 480px) {
  .tm-title {
    font-size: 1.8rem;
  }

  .tm-subtitle {
    font-size: 0.9rem;
  }

  .tm-header {
    padding: 1.5rem 1rem;
  }

  .tm-decade-nav {
    padding: 0 1rem;
  }

  .tm-era-card {
    padding: 1rem;
    border-radius: 12px;
  }

  .tm-era-name {
    font-size: 1.5rem;
  }

  .tm-era-tagline {
    font-size: 0.95rem;
  }

  .tm-era-desc {
    font-size: 0.9rem;
  }

  .tm-movies-title {
    font-size: 1.1rem;
  }

  .tm-posters-row {
    gap: 0.6rem;
  }

  .tm-poster-img {
    width: 80px;
    height: 120px;
  }

  .tm-poster-placeholder {
    width: 80px;
    height: 120px;
    font-size: 0.65rem;
  }
}


/* DIRECTORS-CUT */
/* ═════════════════════════════════════════════════════════════════════════════
   DIRECTORS CUT - DIRECTOR WORLDS
   Cinematic Grid, Complete Director DNA, Thematic Filmography
   ═════════════════════════════════════════════════════════════════════════════ */

.dc-root {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  padding: 0;
  background: linear-gradient(180deg, #0a0e14 0%, #0f1318 100%);
  color: #ffffff;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  min-height: 100vh;
}

/* ─────────────────────────────────────────────────────────────────
   HEADER
   ───────────────────────────────────────────────────────────────── */

.dc-header {
  padding: 3rem 2rem;
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(10, 14, 20, 0.6) 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  animation: dc-fadeInUp 0.8s ease 0.1s both;
}

.dc-title {
  font-size: 3.2rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0 0 0.5rem 0;
  background: linear-gradient(135deg, #ffffff 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.dc-subtitle {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
  font-weight: 400;
  letter-spacing: 0.01em;
}

/* ─────────────────────────────────────────────────────────────────
   SEARCH CONTROLS
   ───────────────────────────────────────────────────────────────── */

.dc-controls {
  padding: 0 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

.dc-search {
  width: 100%;
  max-width: 400px;
  padding: 0.8rem 1.2rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  color: #fff;
  font-size: 0.95rem;
  font-family: inherit;
  outline: none;
  transition: all 0.3s ease;
}

.dc-search::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.dc-search:focus {
  border-color: #00d4ff;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.1);
}

/* ─────────────────────────────────────────────────────────────────
   DIRECTOR GRID
   ───────────────────────────────────────────────────────────────── */

.dc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 1rem;
  padding: 0 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  animation: dc-fadeIn 0.8s ease 0.2s both;
}

.dc-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1.2rem 1rem;
  background: rgba(255, 255, 255, 0.03);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  text-align: center;
  font-family: inherit;
  color: inherit;
}

.dc-card:hover {
  border-color: rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.08);
  transform: translateY(-4px);
}

.dc-card--active {
  border-width: 2px;
  box-shadow: 0 0 30px currentColor;
  transform: scale(1.08);
  font-weight: 700;
}

.dc-card-emoji {
  font-size: 2rem;
  margin-bottom: 0.3rem;
}

.dc-card-name {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
}

.dc-card-description {
  font-size: 0.7rem;
  color: rgba(255, 255, 255, 0.6);
  margin: 0.3rem 0 0 0;
  font-style: italic;
}

.dc-card-style {
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.4);
  margin: 0.4rem 0 0 0;
  line-height: 1.3;
}

/* ─────────────────────────────────────────────────────────────────
   DIRECTOR WORLD PREVIEW
   ───────────────────────────────────────────────────────────────── */

.dc-world {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  padding: 3rem 2rem;
  margin: 0 auto;
  max-width: 1200px;
  width: 100%;
  border: 1px solid;
  border-radius: 20px;
  position: relative;
  overflow: hidden;
  animation: dc-fadeIn 0.5s ease;
  transition: all 0.5s ease;
}

.dc-world::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.03), transparent 70%);
  pointer-events: none;
  border-radius: 50%;
}

/* Director Header */
.dc-world-header {
  display: flex;
  align-items: center;
  gap: 2rem;
  position: relative;
  z-index: 1;
}

.dc-world-emoji {
  font-size: 4rem;
  flex-shrink: 0;
}

.dc-world-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.dc-world-name {
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.2;
  margin: 0;
  letter-spacing: -0.01em;
}

.dc-world-description {
  font-size: 1.2rem;
  font-weight: 600;
  margin: 0;
  opacity: 0.9;
}

.dc-world-style {
  font-size: 0.95rem;
  margin: 0;
  opacity: 0.7;
  line-height: 1.5;
}

/* ─────────────────────────────────────────────────────────────────
   DIRECTOR DNA
   ───────────────────────────────────────────────────────────────── */

.dc-dna-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding: 2rem;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  border-left: 4px solid;
}

.dc-dna-title {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 0.01em;
}

.dc-dna-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin: 0 0 0.6rem 0;
  opacity: 0.7;
}

/* Color Palette */
.dc-dna-palette {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.dc-palette-colors {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.dc-color-swatch {
  width: 60px;
  height: 60px;
  border-radius: 10px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  cursor: pointer;
  transition: all 0.3s ease;
}

.dc-color-swatch:hover {
  transform: scale(1.1);
  border-color: rgba(255, 255, 255, 0.5);
}

/* Traits */
.dc-dna-traits {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.dc-traits-list {
  display: flex;
  gap: 0.7rem;
  flex-wrap: wrap;
}

.dc-trait-tag {
  padding: 0.5rem 1rem;
  border: 2px solid;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  background: transparent;
  transition: all 0.3s ease;
}

.dc-trait-tag:hover {
  background: currentColor;
  color: inherit;
}

/* Signature */
.dc-signature {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
}

.dc-signature-text {
  font-size: 1rem;
  font-style: italic;
  margin: 0;
  opacity: 0.9;
  line-height: 1.6;
}

/* Influences */
.dc-influences {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.dc-influence-block {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.dc-influence-names {
  font-size: 0.95rem;
  margin: 0;
  opacity: 0.85;
  line-height: 1.6;
}

/* ─────────────────────────────────────────────────────────────────
   FILMOGRAPHY BY THEME
   ───────────────────────────────────────────────────────────────── */

.dc-filmography-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.dc-filmography-title {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 0.01em;
}

.dc-theme-block {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  padding: 1.2rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border-left: 3px solid;
}

.dc-theme-name {
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 0.02em;
}

.dc-movies-in-theme {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.dc-movie-badge {
  padding: 0.5rem 0.9rem;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 500;
  transition: all 0.3s ease;
}

.dc-movie-badge:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.25);
  transform: translateY(-2px);
}

/* ─────────────────────────────────────────────────────────────────
   POSTERS SECTION
   ───────────────────────────────────────────────────────────────── */

.dc-posters-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.dc-posters-title {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0;
  letter-spacing: 0.01em;
}

.dc-posters-row {
  display: flex;
  gap: 1.2rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
}

.dc-posters-row::-webkit-scrollbar {
  height: 4px;
}

.dc-posters-row::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2px;
}

.dc-poster-btn {
  flex-shrink: 0;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  transition: all 0.3s ease;
  font-family: inherit;
}

.dc-poster-btn:hover {
  transform: translateY(-6px) scale(1.05);
}

.dc-poster-img {
  width: 130px;
  height: 195px;
  object-fit: cover;
  border-radius: 10px;
  display: block;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: box-shadow 0.3s ease;
}

.dc-poster-btn:hover .dc-poster-img {
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.8);
}

.dc-poster-placeholder {
  width: 130px;
  height: 195px;
  border-radius: 10px;
  border: 2px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  padding: 0.8rem;
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.03);
}

.dc-poster-title {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.5);
  max-width: 130px;
  text-align: center;
  line-height: 1.3;
  font-weight: 500;
}

/* ─────────────────────────────────────────────────────────────────
   ANIMATIONS
   ───────────────────────────────────────────────────────────────── */

@keyframes dc-fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dc-fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─────────────────────────────────────────────────────────────────
   RESPONSIVE
   ───────────────────────────────────────────────────────────────── */

@media (max-width: 1024px) {
  .dc-grid {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.8rem;
  }

  .dc-influences {
    grid-template-columns: 1fr;
  }

  .dc-world-header {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 768px) {
  .dc-header {
    padding: 2rem 1.5rem;
  }

  .dc-title {
    font-size: 2.2rem;
  }

  .dc-grid {
    padding: 0 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  }

  .dc-world {
    padding: 1.5rem;
    gap: 1.5rem;
  }

  .dc-world-name {
    font-size: 1.8rem;
  }

  .dc-dna-section {
    padding: 1.5rem;
  }

  .dc-posters-row {
    gap: 0.8rem;
  }

  .dc-poster-img {
    width: 100px;
    height: 150px;
  }

  .dc-poster-placeholder {
    width: 100px;
    height: 150px;
  }

  .dc-poster-title {
    max-width: 100px;
    font-size: 0.7rem;
  }
}

@media (max-width: 480px) {
  .dc-title {
    font-size: 1.8rem;
  }

  .dc-subtitle {
    font-size: 0.9rem;
  }

  .dc-header {
    padding: 1.5rem 1rem;
  }

  .dc-controls {
    padding: 0 1rem;
  }

  .dc-search {
    max-width: 100%;
  }

  .dc-grid {
    padding: 0 1rem;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.6rem;
  }

  .dc-card-emoji {
    font-size: 1.5rem;
  }

  .dc-card-name {
    font-size: 0.8rem;
  }

  .dc-world {
    padding: 1rem;
    border-radius: 12px;
  }

  .dc-world-emoji {
    font-size: 3rem;
  }

  .dc-world-name {
    font-size: 1.5rem;
  }

  .dc-dna-section {
    padding: 1rem;
  }

  .dc-posters-row {
    gap: 0.6rem;
  }

  .dc-poster-img {
    width: 80px;
    height: 120px;
  }

  .dc-poster-placeholder {
    width: 80px;
    height: 120px;
    font-size: 0.65rem;
  }
}
/* ========================================================================
   AUTH PAGES
   ======================================================================== */

.auth-page {
  position: relative;
  min-height: calc(100vh - var(--header-height));
  padding: 4rem 1.5rem;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(0, 212, 255, 0.14), transparent 30%),
    radial-gradient(circle at bottom right, rgba(0, 153, 204, 0.16), transparent 28%),
    linear-gradient(180deg, #0b1016 0%, #131b24 48%, #0d1218 100%);
}

.auth-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(10px);
  opacity: 0.6;
  pointer-events: none;
}

.auth-orb--one {
  top: 8%;
  left: -4rem;
  width: 18rem;
  height: 18rem;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.25), transparent 70%);
}

.auth-orb--two {
  right: -6rem;
  bottom: 6%;
  width: 22rem;
  height: 22rem;
  background: radial-gradient(circle, rgba(15, 133, 255, 0.18), transparent 70%);
}

.auth-shell {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 460px);
  gap: 2rem;
  align-items: center;
}

.auth-hero {
  padding: 2rem 0;
}

.auth-kicker {
  display: inline-flex;
  padding: 0.45rem 0.85rem;
  border-radius: 999px;
  border: 1px solid rgba(0, 212, 255, 0.25);
  background: rgba(0, 212, 255, 0.08);
  color: var(--color-accent);
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.72rem;
  font-weight: 700;
}

.auth-hero h1 {
  margin-top: 1.2rem;
  max-width: 12ch;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.04em;
  font-family: 'Bebas Neue', 'Inter', sans-serif;
  color: var(--color-text-primary);
}

.auth-copy {
  margin-top: 1.2rem;
  max-width: 34rem;
  color: var(--color-text-secondary);
  font-size: 1.05rem;
  line-height: 1.8;
}

.auth-feature-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-top: 2rem;
}

.auth-feature-pill {
  padding: 0.8rem 1rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--color-text-primary);
  backdrop-filter: blur(12px);
}

.auth-card {
  position: relative;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 28px;
  padding: 2rem;
  background: linear-gradient(180deg, rgba(15, 20, 28, 0.92), rgba(20, 30, 41, 0.88));
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(0, 212, 255, 0.08);
  backdrop-filter: blur(20px);
}

.auth-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.32), transparent 40%, rgba(0, 212, 255, 0.18));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.auth-card-header h2 {
  margin-top: 1.4rem;
  font-size: 2rem;
  font-weight: 800;
}

.auth-card-header p {
  margin-top: 0.45rem;
  color: var(--color-text-secondary);
}

.auth-mark {
  display: inline-grid;
  grid-template-columns: repeat(3, 18px);
  gap: 0.45rem;
}

.auth-mark__tile {
  height: 18px;
  border-radius: 6px;
  display: block;
  transform: rotate(18deg);
}

.auth-mark__tile--one {
  background: linear-gradient(135deg, #00d4ff, #37f3ff);
}

.auth-mark__tile--two {
  background: linear-gradient(135deg, #82e5ff, #00a7d1);
}

.auth-mark__tile--three {
  background: linear-gradient(135deg, #005d7a, #00d4ff);
}

.auth-form {
  display: grid;
  gap: 1rem;
  margin-top: 1.8rem;
}

.auth-field {
  display: grid;
  gap: 0.45rem;
}

.auth-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0.04em;
}

.auth-input {
  width: 100%;
  padding: 0.95rem 1rem;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--color-text-primary);
  font-size: 1rem;
  transition: border-color var(--transition-speed) ease, box-shadow var(--transition-speed) ease, transform var(--transition-speed) ease;
}

.auth-input::placeholder {
  color: rgba(255, 255, 255, 0.35);
}

.auth-input:focus {
  border-color: rgba(0, 212, 255, 0.65);
  box-shadow: 0 0 0 4px rgba(0, 212, 255, 0.12);
  transform: translateY(-1px);
}

.auth-input--error {
  border-color: #ff6b81;
}

.auth-password-wrap {
  position: relative;
}

.auth-password-wrap .auth-input {
  padding-right: 4.8rem;
}

.auth-toggle {
  position: absolute;
  top: 50%;
  right: 0.9rem;
  transform: translateY(-50%);
  background: transparent;
  color: var(--color-accent);
  font-weight: 700;
  font-size: 0.82rem;
}

.auth-error {
  color: #ff94a4;
  font-size: 0.84rem;
}

.auth-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  margin-top: 0.35rem;
}

.auth-check {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--color-text-secondary);
  font-size: 0.95rem;
}

.auth-check input {
  width: 1rem;
  height: 1rem;
  accent-color: var(--color-accent);
}

.auth-inline-link,
.auth-switch a {
  color: var(--color-accent);
  font-weight: 600;
}

.auth-submit {
  margin-top: 0.35rem;
  min-height: 54px;
  border-radius: 16px;
  background: linear-gradient(135deg, #00d4ff, #0099cc);
  color: #051018;
  font-size: 0.95rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease, opacity var(--transition-speed) ease;
  box-shadow: 0 18px 40px rgba(0, 212, 255, 0.25);
}

.auth-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 22px 42px rgba(0, 212, 255, 0.3);
}

.auth-submit:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.4rem 0 1rem;
  color: var(--color-text-secondary);
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
}

.auth-socials {
  display: grid;
  gap: 0.85rem;
}

.auth-social {
  min-height: 50px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--color-text-primary);
  font-weight: 600;
  transition: transform var(--transition-speed) ease, border-color var(--transition-speed) ease, background-color var(--transition-speed) ease;
}

.auth-social:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 212, 255, 0.3);
  background: rgba(255, 255, 255, 0.06);
}

.auth-switch {
  margin-top: 1.25rem;
  color: var(--color-text-secondary);
  text-align: center;
}

.auth-success {
  margin-top: 1.25rem;
  padding: 1rem 1.1rem;
  border-radius: 16px;
  border: 1px solid rgba(0, 212, 255, 0.2);
  background: rgba(0, 212, 255, 0.08);
  color: #d9f8ff;
  display: grid;
  gap: 0.2rem;
}

@media (max-width: 960px) {
  .auth-shell {
    grid-template-columns: 1fr;
  }

  .auth-hero {
    padding: 0;
  }

  .auth-hero h1 {
    max-width: none;
  }
}

@media (max-width: 640px) {
  .auth-page {
    padding: 2rem 1rem;
  }

  .auth-card {
    padding: 1.35rem;
    border-radius: 22px;
  }

  .auth-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .auth-feature-list {
    gap: 0.6rem;
  }

  .auth-feature-pill {
    width: 100%;
    justify-content: center;
    text-align: center;
  }
}
/␀*␀ ␀A␀c␀c␀o␀u␀n␀t␀ ␀M␀e␀n␀u␀ ␀S␀t␀y␀l␀e␀s␀ ␀*␀/␀
␀.␀a␀c␀c␀o␀u␀n␀t␀-␀m␀e␀n␀u␀ ␀{␀
␀ ␀ ␀p␀o␀s␀i␀t␀i␀o␀n␀:␀ ␀r␀e␀l␀a␀t␀i␀v␀e␀;␀
␀}␀
␀
␀.␀a␀c␀c␀o␀u␀n␀t␀-␀b␀t␀n␀ ␀{␀
␀ ␀ ␀d␀i␀s␀p␀l␀a␀y␀:␀ ␀f␀l␀e␀x␀;␀
␀ ␀ ␀a␀l␀i␀g␀n␀-␀i␀t␀e␀m␀s␀:␀ ␀c␀e␀n␀t␀e␀r␀;␀
␀ ␀ ␀g␀a␀p␀:␀ ␀0␀.␀5␀r␀e␀m␀;␀
␀ ␀ ␀p␀a␀d␀d␀i␀n␀g␀:␀ ␀0␀.␀5␀r␀e␀m␀ ␀1␀r␀e␀m␀;␀
␀ ␀ ␀b␀a␀c␀k␀g␀r␀o␀u␀n␀d␀:␀ ␀t␀r␀a␀n␀s␀p␀a␀r␀e␀n␀t␀;␀
␀ ␀ ␀c␀o␀l␀o␀r␀:␀ ␀v␀a␀r␀(␀-␀-␀c␀o␀l␀o␀r␀-␀t␀e␀x␀t␀-␀p␀r␀i␀m␀a␀r␀y␀)␀;␀
␀ ␀ ␀b␀o␀r␀d␀e␀r␀-␀r␀a␀d␀i␀u␀s␀:␀ ␀v␀a␀r␀(␀-␀-␀r␀a␀d␀i␀u␀s␀-␀b␀u␀t␀t␀o␀n␀)␀;␀
␀ ␀ ␀t␀r␀a␀n␀s␀i␀t␀i␀o␀n␀:␀ ␀b␀a␀c␀k␀g␀r␀o␀u␀n␀d␀-␀c␀o␀l␀o␀r␀ ␀v␀a␀r␀(␀-␀-␀t␀r␀a␀n␀s␀i␀t␀i␀o␀n␀-␀s␀p␀e␀e␀d␀)␀ ␀e␀a␀s␀e␀;␀
␀ ␀ ␀f␀o␀n␀t␀-␀s␀i␀z␀e␀:␀ ␀0␀.␀9␀r␀e␀m␀;␀
␀}␀
␀
␀.␀a␀c␀c␀o␀u␀n␀t␀-␀b␀t␀n␀:␀h␀o␀v␀e␀r␀ ␀{␀
␀ ␀ ␀b␀a␀c␀k␀g␀r␀o␀u␀n␀d␀-␀c␀o␀l␀o␀r␀:␀ ␀v␀a␀r␀(␀-␀-␀c␀o␀l␀o␀r␀-␀b␀g␀-␀s␀e␀c␀o␀n␀d␀a␀r␀y␀)␀;␀
␀}␀
␀
␀.␀a␀c␀c␀o␀u␀n␀t␀-␀n␀a␀m␀e␀ ␀{␀
␀ ␀ ␀m␀a␀x␀-␀w␀i␀d␀t␀h␀:␀ ␀1␀2␀0␀p␀x␀;␀
␀ ␀ ␀o␀v␀e␀r␀f␀l␀o␀w␀:␀ ␀h␀i␀d␀d␀e␀n␀;␀
␀ ␀ ␀t␀e␀x␀t␀-␀o␀v␀e␀r␀f␀l␀o␀w␀:␀ ␀e␀l␀l␀i␀p␀s␀i␀s␀;␀
␀ ␀ ␀w␀h␀i␀t␀e␀-␀s␀p␀a␀c␀e␀:␀ ␀n␀o␀w␀r␀a␀p␀;␀
